# Copy to agent-service/.env (do not commit .env). Loaded automatically by Day5.
# Default RULES mode works WITHOUT any model API key.
BANK_API_MODE=mock
BANK_API_BASE=http://127.0.0.1:8080/api/demo
BANK_TRANSFER_API_BASE=http://127.0.0.1:8080/api/transfers
MODEL_MODE=compatible
MODEL_API_KEY=YOUR_API_KEY_HERE
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# EXAMPLE DeepSeek (uncomment/fill with your own separately obtained key):
# MODEL_MODE=compatible
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=your_secret_key_here
# EXAMPLE Qwen (choose the *actual* WorkspaceId and geographic endpoint in your console):
# MODEL_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
