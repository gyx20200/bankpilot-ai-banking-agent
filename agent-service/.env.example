# Export these environment variables in your PowerShell before running uvicorn.
# Python does not auto-load this file. No real secrets in Git.
BANK_API_BASE=http://127.0.0.1:8080/api/demo
BANK_TRANSFER_API_BASE=http://127.0.0.1:8080/api/transfers
BANK_API_MODE=java
# To test with local mock_backend.py (no MySQL), set BANK_API_MODE=mock.
# Real Java transfer endpoint MUST validate the user's Authorization bearer token.
