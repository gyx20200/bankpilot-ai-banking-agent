+const phone = ref('')
+const confirmation = ref('')
+const validationError = ref('')
+
+function clearInputs() {
+  username.value = ''
+  password.value = ''
+  confirmation.value = ''
+  fullName.value = ''
+  phone.value = ''
+  validationError.value = ''
+}
+watch(() => props.mode, clearInputs)
+
+function switchMode(mode) {
+  if (props.busy || mode === props.mode) return
+  clearInputs()
