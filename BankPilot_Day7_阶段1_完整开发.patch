+
+function submit() {
+  if (props.busy) return
+  validationError.value = ''
+  const name = username.value.trim()
+  if (props.mode === 'login') {
+    if (!name || !password.value) {
+      validationError.value = '请填写用户名和密码。'
+      return
+    }
+    emit('login', { username: name, password: password.value })
+    password.value = ''
+    return
+  }
+  if (!/^[A-Za-z0-9_]{3,32}$/.test(name)) {
+    validationError.value = '用户名须为3～32位字母、数字或下划线。'
+    return
+  }
+  if (password.value.length < 8 || password.value.length > 128) {
+    validationError.value = '密码长度须为8～128位。'
+    return
+  }
+  if (password.value !== confirmation.value) {
+    validationError.value = '两次输入的密码不一致。'
+    return
+  }
+  if (!fullName.value.trim() || fullName.value.trim().length > 50) {
+    validationError.value = '姓名不能为空，且不能超过50个字符。'
+    return
+  }
+  if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
+    validationError.value = '请填写正确的11位手机号。'
+    return
+  }
+  emit('register', {
+    username: name,
+    password: password.value,
+    fullName: fullName.value.trim(),
+    phone: phone.value.trim(),
+  })
+  password.value = ''
+  confirmation.value = ''
+}
+</script>
+
+<template>
+  <div class="auth-panel" aria-label="银行用户认证">
+    <div class="auth-topline">BANKPILOT · DAY 07</div>
+    <h1>{{ mode === 'login' ? '登录模拟银行账户' : '注册模拟银行账户' }}</h1>
+    <p class="auth-subtitle">{{ mode === 'login' ? '登录后访问仅属于你的银行数据和 AI 助手。' : '每人一个独立模拟账户，注册成功后请自行登录。' }}</p>
+    <div class="auth-tabs" role="group" aria-label="选择注册或登录">
+      <button type="button" :class="{active: mode === 'login'}" :disabled="busy" @click="switchMode('login')">登录</button>
+      <button type="button" :class="{active: mode === 'register'}" :disabled="busy" @click="switchMode('register')">注册</button>
+    </div>
+    <form class="auth-form" @submit.prevent="submit">
+      <label for="bank-username">用户名</label>
+      <input id="bank-username" v-model="username" name="username" autocomplete="username" maxlength="32" required :disabled="busy" placeholder="请输入用户名" />
+      <template v-if="mode === 'register'">
+        <label for="bank-full-name">姓名</label>
+        <input id="bank-full-name" v-model="fullName" autocomplete="name" maxlength="50" required :disabled="busy" placeholder="模拟银行账户姓名" />
+        <label for="bank-phone">手机号</label>
+        <input id="bank-phone" v-model="phone" type="tel" autocomplete="tel" maxlength="11" required :disabled="busy" placeholder="11位手机号码" />
+      </template>
+      <label for="bank-password">密码</label>
+      <input id="bank-password" v-model="password" type="password" :autocomplete="mode === 'login' ? 'current-password' : 'new-password'" :minlength="mode === 'register' ? 8 : 1" maxlength="128" required :disabled="busy" placeholder="请输入密码" />
+      <template v-if="mode === 'register'">
+        <label for="bank-confirm-password">确认密码</label>
+        <input id="bank-confirm-password" v-model="confirmation" type="password" autocomplete="new-password" minlength="8" maxlength="128" required :disabled="busy" placeholder="再次输入密码" />
+      </template>
+      <p v-if="validationError" class="auth-error" role="alert">{{ validationError }}</p>
+      <p v-if="notice" class="auth-notice" role="status">{{ notice }}</p>
+      <button type="submit" class="auth-submit" :disabled="busy">{{ busy ? '请稍候…' : (mode === 'login' ? '登录' : '注册账户') }}</button>
+    </form>
+    <p class="auth-footnote">仅供模拟银行演示 · 不保存登录 Token 到浏览器本地存储</p>
+  </div>
+</template>
